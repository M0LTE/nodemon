@page
@model IndexModel

<h1>nodemon</h1>

<div id="chartArea">
</div>

<script src="//cdn.jsdelivr.net/chartist.js/latest/chartist.min.js"></script>
<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/node.js"></script>

<div class="container">
    <div class="row mb-2">
        <div class="col-sm">
            <label for="toggle1" class="form-label">2m radio</label>
            <input type="checkbox" class="form-control" data-toggle="toggle" checked id="toggle1" onclick="toggle1(this)" />
        </div>
        <div class="col-sm">
            <label for="channel_1" class="form-label">Channel</label>
            <select id="channel_1" asp-items="Model.PortChannels2m"></select>
        </div>
        <div class="col-sm">
            <label for="vswr_1" class="form-label">VSWR</label>
            <span id="vswr_1" />
        </div>
        <div class="col-sm">
            <label for="ninoMode_1" class="form-label">Mode</label>
            <select id="ninoMode_1" asp-items="Model.Modes"></select>
        </div>
    </div>
    <div class="row">
        <div class="col-sm">
            <label for="toggle2" class="form-label">4m radio</label>
            <input type="checkbox" class="form-control" data-toggle="toggle" checked id="toggle2" onclick="toggle2(this)" />
        </div>
    </div>
</div>

<link rel="stylesheet" href="//cdn.jsdelivr.net/chartist.js/latest/chartist.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap5-toggle@5.1.1/css/bootstrap5-toggle.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap5-toggle@5.1.1/js/bootstrap5-toggle.ecmas.min.js"></script>
<style>
    .ct-series-a .ct-line {
        stroke-width: 1px;
    }
</style>